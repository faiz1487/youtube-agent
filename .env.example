# ========================================================
# AUTOMATED YOUTUBE MUSIC CHANNEL AGENT CONFIGURATION
# ========================================================

# 1. OpenAI Configuration (Lyrics, Title, Prompt & DALL-E)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
GENERATE_AI_COVER=true

# 2. Suno AI Configuration
# Mode: "cookie" (using your personal Suno account cookie) OR "api_gateway" (using a Suno API provider)
SUNO_MODE=cookie

# If SUNO_MODE=cookie, paste your Suno session cookie (__client or session token from app.suno.ai)
SUNO_COOKIE=your_suno_session_cookie_here

# If SUNO_MODE=api_gateway, provide the base URL and API key of your Suno provider/instance
SUNO_API_URL=https://api.suno.ai
SUNO_API_KEY=your_suno_api_key_here

# 3. YouTube Data API v3 Configuration
# Generated in Google Cloud Console (OAuth 2.0 Client IDs -> Desktop App)
YOUTUBE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_google_client_secret

# Generated using python scripts/setup_youtube_oauth.py
YOUTUBE_REFRESH_TOKEN=your_oauth_refresh_token_here

# Upload Settings: "public", "unlisted", or "private"
# TIP: Start with "private" or "unlisted" for testing!
YOUTUBE_PRIVACY_STATUS=public

# Music Genre Preferences (comma separated, agent picks one randomly or in rotation)
MUSIC_GENRES=Synthwave,Lo-Fi Chillhop,Cyberpunk Melodic,Epic Cinematic Orchestral,Indie Dream Pop,Acoustic Folk Ballad,Future Bass

# Video Resolution (default: 1920x1080)
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
